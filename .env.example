# =============================================================================
# Lumen environment — 02-ARCHITECTURE.md §6
#
# Copy to .env.local for development:   cp .env.example .env.local
#
# Two halves, and the line between them matters:
#   PUBLIC  — NEXT_PUBLIC_* is inlined into the browser bundle. Anything here is world-readable.
#   SECRET  — never in the client bundle. In production these live as Supabase Function secrets
#             and Cloudflare Worker secrets, not in any file. `lib/env.ts` refuses to read them
#             from the browser, and `tests/unit/no-client-secrets.test.ts` greps the built bundle
#             for every name in this file's SECRET half.
# =============================================================================

# -----------------------------------------------------------------------------
# PUBLIC — safe in the client bundle
# -----------------------------------------------------------------------------

# The product name is still an open decision (00-BRIEF.md §9); it lives in one constant + this var.
NEXT_PUBLIC_APP_NAME=Lumen
NEXT_PUBLIC_APP_URL=http://localhost:3000
# local | preview | production
NEXT_PUBLIC_ENV=local

# REQUIRED. Supabase project URL + anon key. The defaults below are `supabase start`'s local
# values, which are the same on every machine and are not secrets.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlLWRlbW8iLCJpYXQiOjE2NDE3NjkyMDAsImV4cCI6MTc5OTUzNTYwMH0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE

# Cloudflare Turnstile, gating signed-out enhancement (02-ARCHITECTURE.md §7 layer 3).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Error monitoring. Sentry stays off unless NEXT_PUBLIC_SENTRY_ENABLED is true.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENABLED=false

# First-party funnel beacon + Cloudflare Web Analytics token. Both no-op when blank.
NEXT_PUBLIC_ANALYTICS_BEACON_URL=
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=

# Serves the /dev design harness (the gold-fixture note, the options screen, the error states).
# Always on outside production; set it to 1 in a production build only to let the end-to-end
# suite reach those screens. The live site leaves it unset.
NEXT_PUBLIC_DEV_SCREENS=

# -----------------------------------------------------------------------------
# SECRET — server only. Never prefix any of these with NEXT_PUBLIC_.
# -----------------------------------------------------------------------------

# Shared primary LLM key. Every free-tier enhancement runs on this, which is why the three
# guardrails in 02-ARCHITECTURE.md §7 exist.
DEEPSEEK_API_KEY=

# Shared fallback (free tier) + the opt-in "free but Google may train on it" path.
GEMINI_API_KEY=

# Encrypts users' BYOK keys and integration tokens at rest. 32 random bytes, base64.
# Generate with:  openssl rand -base64 32
#
# 02-ARCHITECTURE.md §6 calls this a libsodium secretbox key. The edge function uses Web Crypto's
# AES-256-GCM instead — same key material, same strength, and no npm WebAssembly module in the one
# code path where a load failure would lock a student out of their own API key. The ciphertext
# carries a version tag, so moving to secretbox later can still read what this wrote.
BYOK_ENC_KEY=

# Signs the anonymous id that is the quota key for signed-out students (02 §5). Any long random
# string. Falls back to SUPABASE_SERVICE_ROLE_KEY when unset, so a deployment works before anyone
# remembers to set one; rotating either invalidates outstanding ids, which costs a student nothing
# more than a fresh daily allowance.
ANON_ID_SECRET=

# Notion integration (phase-07).
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=

# Google Drive integration (phase-07).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Bypasses RLS. Only ever read inside a Supabase edge function.
SUPABASE_SERVICE_ROLE_KEY=

# Server-side Sentry DSN (edge functions).
SENTRY_DSN=

# Turnstile server-side verification secret. When it is unset the edge functions skip the human
# check and log that they did — a deliberate, visible hole rather than a deployment that fails
# closed on a variable nobody remembers setting.
TURNSTILE_SECRET=
KEEPALIVE_SECRET=

# Comma-separated origins the edge functions accept. Unset allows any origin, which is right
# locally and wrong in production.
ALLOWED_ORIGINS=

# Overrides https://api.deepseek.com. Set by the guardrail integration tests to point at the
# scripted provider inside the same runtime; unset in production.
DEEPSEEK_BASE_URL=

# How long the edge functions cache `app_config`, in ms. Default 60000. The integration tests set
# it to 0 because they change a cap and expect the very next request to obey it.
APP_CONFIG_TTL_MS=

# -----------------------------------------------------------------------------
# DEPLOY — CI and local deploys only. Not read by the app at runtime, so these are not in
# lib/env.ts. In CI they are GitHub Actions secrets.
# -----------------------------------------------------------------------------
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_PROJECT_REF=
