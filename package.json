{
  "name": "lumen",
  "version": "0.1.0",
  "private": true,
  "description": "Turn messy class notes into a complete, correct, beautiful study guide.",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "setup:env": "node scripts/setup-env.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run --project unit",
    "test:bundle": "REQUIRE_BUNDLE=1 vitest run --project unit tests/unit/no-client-secrets.test.ts",
    "test:budget": "node scripts/check-route-budget.mjs",
    "shoot": "node scripts/shoot-marketing.mjs",
    "shoot:app": "node scripts/shoot-app.mjs",
    "lh": "lhci autorun --config=lighthouserc.cjs",
    "lh:mobile": "lhci autorun --config=lighthouserc.mobile.cjs",
    "lh:preview": "node -e \"if(!process.env.LH_BASE_URL)throw new Error('Set LH_BASE_URL to the deployed origin, e.g. LH_BASE_URL=https://pr-2-lumen.marvinmaiwang.workers.dev pnpm lh:preview')\" && lhci autorun --config=lighthouserc.cjs && lhci autorun --config=lighthouserc.mobile.cjs",
    "test:unit:watch": "vitest --project unit",
    "test:ai": "vitest run --project ai-evals --passWithNoTests",
    "test:edge": "node scripts/test-edge.mjs",
    "test:rls": "node scripts/test-rls.mjs",
    "test:sync": "node scripts/test-sync.mjs",
    "test:account-delete": "node scripts/test-account-delete.mjs",
    "check:edge": "deno check --config supabase/functions/deno.json supabase/functions/*/index.ts",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006 --no-open",
    "build:storybook": "storybook build -o storybook-static",
    "test:stories": "vitest run --project storybook",
    "pack:validate": "node scripts/pack-validate.mjs",
    "fixtures:build": "node scripts/build-fixture.mjs",
    "fixtures:ingest": "node scripts/build-ingest-fixtures.mjs",
    "og:build": "node scripts/build-og.mjs",
    "cf:build": "opennextjs-cloudflare build && opennextjs-cloudflare populateCache local",
    "check:worker": "node scripts/check-worker-routes.mjs",
    "check:worker:size": "node scripts/check-worker-size.mjs",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:serve": "supabase functions serve --no-verify-jwt",
    "prepare": "husky"
  },
  "dependencies": {
    "@sentry/nextjs": "10.71.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "@tanstack/react-query": "5.102.8",
    "@tiptap/core": "3.30.5",
    "@tiptap/pm": "3.30.5",
    "@tiptap/react": "3.30.5",
    "@tiptap/starter-kit": "3.30.5",
    "clsx": "2.1.1",
    "fflate": "^0.8.3",
    "heic2any": "0.0.4",
    "idb": "8.0.3",
    "katex": "0.18.4",
    "mammoth": "1.12.2",
    "mermaid": "11.17.2",
    "next": "15.5.24",
    "next-intl": "^4.14.1",
    "pagedjs": "0.4.3",
    "pdfjs-dist": "6.3.289",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "smiles-drawer": "2.4.1",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@lhci/cli": "0.15.1",
    "@opennextjs/cloudflare": "1.20.4",
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/addon-docs": "10.5.10",
    "@storybook/addon-themes": "10.5.10",
    "@storybook/addon-vitest": "10.5.10",
    "@storybook/nextjs-vite": "10.5.10",
    "@tailwindcss/postcss": "4.3.3",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.24",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-better-tailwindcss": "4.7.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "globals": "^16.5.0",
    "husky": "9.1.7",
    "lint-staged": "17.4.1",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "storybook": "10.5.10",
    "supabase": "2.116.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vite": "^7.3.6",
    "vitest": "4.1.11",
    "wrangler": "4.127.0"
  }
}
