# Local/CI only. Points the shared "DeepSeek" provider at the scripted one in this same runtime,
# so the guardrails can be driven end to end without a paid call. Never used in a deployment.
DEEPSEEK_API_KEY=test-key
DEEPSEEK_BASE_URL=http://kong:8000/functions/v1/test-provider
ALLOW_TEST_PROVIDER=1
BYOK_ENC_KEY=Zm9vYmFyZm9vYmFyZm9vYmFyZm9vYmFyMTIzNDU2Nzg=
ANON_ID_SECRET=local-test-secret
# The tests change a cap and expect the next request to obey it.
APP_CONFIG_TTL_MS=0
# Not a real secret: this file is committed. Production gets one from `pnpm setup:env`.
KEEPALIVE_SECRET=test-keepalive-secret

# Deliberately blank, because that is the shape production has: a GitHub Actions `${{ vars.X }}`
# for an undefined variable expands to an empty string, so the deployed functions get an env var
# that exists and is empty. `siteUrl()` used `??`, which does not fall back on '', and both OAuth
# callbacks answered 500 in production while returning 303 here. Keeping it empty means the
# guardrail below exercises the deployed shape rather than a friendlier local one.
PUBLIC_SITE_URL=
